{
  "name": "ultimate-freestyle",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "1.1.18",
    "browserslist": "4.28.9",
    "fast-uri": "4.1.4",
    "hono": "4.13.0",
    "ip-address": "10.4.0",
    "qs": "6.16.0",
    "js-yaml": "4.3.1",
    "undici": "7.29.0"
  },
  "scripts": {
    "test": "bun run test:mcp",
    "dev:mcp": "bun run --cwd apps/mcp-server dev",
    "test:mcp": "bun run --cwd apps/mcp-server check",
    "test:mcp:coverage": "bun run --cwd apps/mcp-server test:coverage",
    "test:mcp:render": "bun run --cwd apps/mcp-server test:render",
    "types:mcp": "bun run --cwd apps/mcp-server types",
    "build:mcp": "bun run --cwd apps/mcp-server build",
    "migrate:mcp": "bun run --cwd apps/mcp-server migrate",
    "deploy:mcp": "bun run --cwd apps/mcp-server deploy",
    "smoke:mcp": "bun run --cwd apps/mcp-server smoke",
    "launch-check:mcp": "bun audit && bun run test:mcp && bun run smoke:mcp",
    "preview:dashboard": "bun run --cwd apps/mcp-server preview:dashboard",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:mcp:runtime": "bun run --cwd apps/mcp-server test:runtime"
  },
  "dependencies": {
    "@ultimate-freestyle/research-schema": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "wrangler": "4.118.0"
  },
  "type": "module"
}
