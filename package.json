{
  "name": "ultimate-freestyle",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "1.1.18",
    "fast-uri": "4.1.2",
    "hono": "4.13.0",
    "ip-address": "10.4.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "vite": "8.2.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "dev:voicevox": "NEXT_PUBLIC_USE_GENERATED_AUDIO=true NEXT_PUBLIC_GENERATED_AUDIO_ROOT=/.voicevox-preview/researches WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "bun run build && node --test tests/*.test.mjs && bun run test:mcp",
    "dev:mcp": "bun run --cwd apps/mcp-server dev",
    "preview:dashboard": "bun run --cwd apps/mcp-server preview:dashboard",
    "build:mcp": "bun run --cwd apps/mcp-server build",
    "migrate:mcp": "bun run --cwd apps/mcp-server migrate",
    "deploy:mcp": "bun run --cwd apps/mcp-server deploy",
    "smoke:mcp": "bun run --cwd apps/mcp-server smoke",
    "launch-check:mcp": "bun audit && bun run test:mcp && bun run smoke:mcp",
    "test:mcp": "bun run --cwd apps/mcp-server check",
    "test:mcp:coverage": "bun run --cwd apps/mcp-server test:coverage",
    "test:mcp:render": "bun run --cwd apps/mcp-server test:render",
    "types:mcp": "bun run --cwd apps/mcp-server types",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "voicevox:list": "bun scripts/generate-voicevox.ts --list",
    "voicevox:generate": "bun scripts/generate-voicevox.ts",
    "voicevox:sync": "bun scripts/sync-voicevox-audio.ts"
  },
  "dependencies": {
    "@ultimate-freestyle/research-schema": "workspace:*",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "type": "module"
}
