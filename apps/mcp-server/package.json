{
  "name": "@ultimate-freestyle/mcp-server",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config wrangler.jsonc",
    "dev:typography": "bun scripts/typography-preview.ts",
    "preview:dashboard": "bun scripts/dashboard-preview.ts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --config wrangler.jsonc --dry-run --outdir dist",
    "migrate": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply ultimate-freestyle --remote --config wrangler.jsonc",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --config wrangler.jsonc",
    "smoke": "node scripts/smoke.mjs",
    "test": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vitest run",
    "test:coverage": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vitest run --coverage",
    "test:render": "vitest run --config vitest.render.config.ts",
    "typecheck": "tsc --noEmit",
    "types": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types src/worker-configuration.d.ts --config wrangler.jsonc --env-file .dev.vars.example --include-runtime=false",
    "types:check": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types src/worker-configuration.d.ts --config wrangler.jsonc --env-file .dev.vars.example --include-runtime=false --check",
    "check": "bun run types:check && bun run typecheck && bun run test:coverage && bun run test:runtime && bun run build",
    "test:runtime": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vitest run --config vitest.runtime.config.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-oauth-provider": "0.8.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ultimate-freestyle/research-schema": "workspace:*",
    "agents": "^0.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "@vitest/coverage-istanbul": "4.1.10",
    "typescript": "^7.0.2",
    "vite": "8.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.118.0"
  }
}
